<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.

         The main manifest caps INTERNET with maxSdkVersion="31", and a plain
         uses-permission entry here does not override that attribute during
         manifest merging. Without the permission on API 32+ the Dart VM
         service cannot bind its socket, which breaks `flutter test
         integration_test` and hot reload on modern devices. The explicit
         tools:remove drops the cap for debug builds only; release builds
         keep the main manifest's maxSdkVersion="31".
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:remove="android:maxSdkVersion" />
</manifest>
